# Telegram API credentials - obtain from https://my.telegram.org/apps
# These identify your *application*, not your account.
TDLIB_API_ID=
TDLIB_API_HASH=

# Where TDLib stores its session database and downloaded files.
# WARNING: after login this directory contains your account's auth keys. Keep it private.
TDLIB_DB_DIR=./tdlib-data

# Number of updates retained in the in-memory ring buffer.
# Older updates are dropped once this is exceeded; tg_updates reports dropped=true.
TG_UPDATE_BUFFER_SIZE=1000

# Set to 1 to connect to Telegram's test datacenters instead of production.
TDLIB_USE_TEST_DC=0

# ---------------------------------------------------------------------------
# HTTP transport (`npm run http`) - only needed if other programs must reach
# this server over the network. The stdio transport ignores all of these.
#
# WARNING: this endpoint can send messages, press buttons and spend money as
# the logged-in user, and has no per-caller permission model. Anyone who can
# reach the port with the token has full control of the account.
# ---------------------------------------------------------------------------

# OAuth for public deployments (Claude and other MCP clients). Both required
# together. Users approve a connection by typing TG_OAUTH_ACCESS_CODE on the
# consent page. Min 12 chars; generate with: openssl rand -base64 18
TG_PUBLIC_URL=
TG_OAUTH_ACCESS_CODE=
# Token lifetimes in seconds (defaults: 1h access, 30d refresh).
TG_OAUTH_ACCESS_TOKEN_TTL=3600
TG_OAUTH_REFRESH_TOKEN_TTL=2592000

# Static bearer token for bots/scripts. Generate with: openssl rand -hex 32
# Works alongside OAuth. At least one of OAuth or this token is required.
TG_HTTP_TOKEN=

# Interface to bind. Keep 127.0.0.1 unless you deliberately want remote access;
# binding elsewhere without a token is refused outright.
TG_HTTP_HOST=127.0.0.1
TG_HTTP_PORT=8787
TG_HTTP_PATH=/mcp

# Skip token auth. Only permitted on loopback. Not recommended.
TG_HTTP_ALLOW_NO_AUTH=0

# Comma-separated Host header allowlist (DNS-rebinding protection).
# Defaults to the loopback names for the chosen port.
TG_HTTP_ALLOWED_HOSTS=

# Set to 1 to prefer SSE streaming over plain JSON responses.
TG_HTTP_SSE=0

# Session lifecycle. MCP clients often disconnect without sending DELETE, so
# sessions are expired automatically or they accumulate until restart.
# Set any of these to 0 to disable that particular limit.
TG_HTTP_SESSION_IDLE_MS=1800000     # close after 30m with no requests
TG_HTTP_SESSION_MAX_MS=43200000     # close 12h after opening, active or not
TG_HTTP_MAX_SESSIONS=100            # reject new sessions beyond this many
TG_HTTP_SWEEP_INTERVAL_MS=60000     # how often expiry is checked

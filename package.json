{
  "name": "telegram-tdlib-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the TDLib (Telegram) API as a near-verbatim passthrough for testing Telegram flows as a user",
  "type": "module",
  "bin": {
    "telegram-tdlib-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "gen:schema": "tsx scripts/gen-schema.ts",
    "build": "npm run gen:schema && tsc && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx scripts/test-updates.ts && tsx scripts/test-messages.ts && tsx scripts/test-schema.ts && tsx scripts/test-server.ts",
    "test:live": "tsx scripts/test-live.ts",
    "test:oauth": "tsx scripts/test-oauth.ts",
    "login": "tsx scripts/login.ts",
    "login:secondary": "TDLIB_DB_DIR=./tdlib-data-2 tsx scripts/login.ts",
    "status": "tsx scripts/status.ts",
    "status:secondary": "TDLIB_DB_DIR=./tdlib-data-2 tsx scripts/status.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "prebuilt-tdlib": "^0.1008067.0",
    "tdl": "^8.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
